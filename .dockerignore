# Podman and Docker both read .dockerignore. Docker does not read
# .containerignore, so this file keeps .env out of a Docker build too.

# Git
.git/
.gitignore

# Documentation
README.md
LICENSE
*.md

# Development and agent files (the running app does not read them)
.github/
.specify/
specs/
documentation/

# Container build files
Containerfile
compose.yml
.dockerignore

# Environment files
.env
.env.*
!.env.example

# Python cache
**/__pycache__/
**/*.py[cod]
**/*.so
.pytest_cache/

# Virtual environments
.venv/
venv/

# IDE
.vscode/
.idea/

# Data directories (mounted as volumes; the Containerfile makes empty ones)
data/
input/
output/

# Logs
**/*.log

# Container artifacts
*.tar
*.tar.gz
