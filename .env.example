# Mist API Configuration
MIST_APITOKEN=your_api_token_here
MIST_HOST=api.mist.com
org_id=your_org_id_here

# Application Security
SECRET_KEY=generate_a_random_key_here

# UI Theme Configuration
# Available themes: tmobile, verizon, hackers, matrix
# tmobile  - Magenta/pink corporate dark theme
# verizon  - Red professional dark theme
# hackers  - 90s neon cyberpunk (green/cyan/magenta)
# matrix   - Green digital rain on black
THEME=tmobile

# Logging
CONSOLE_LOG_LEVEL=30
LOGGING_LOG_LEVEL=20

# Interface Classification Thresholds
# WAN threshold: score >= this value classifies as WAN (default 0.3)
# LAN threshold: score <= this value classifies as LAN (default -0.3)
# Scores between thresholds are classified as "unknown"
# INTERFACE_WAN_THRESHOLD=0.3
# INTERFACE_LAN_THRESHOLD=-0.3

# Gunicorn (optional overrides)
# GUNICORN_WORKERS=4
# GUNICORN_BIND=0.0.0.0:8000
# GUNICORN_LOG_LEVEL=info
